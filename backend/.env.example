# ==============================================================================
# QUIZIVERSE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to backend/.env and populate with your credentials.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Security & CORS
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=super_secret_jwt_key_quiziverse_change_this_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting (Tuned for 100+ concurrent students)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# PostgreSQL Database Configuration
# Option A: Discrete Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=quiziverse_db

# Option B: Full Database Connection URL (e.g. Supabase, Neon, Railway)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/quiziverse_db

# Modular AI Service Provider (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
# Optional legacy alias supported:
# AI_API_KEY=YOUR_GEMINI_API_KEY

# SMTP Email Transport Configuration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_gmail_address@gmail.com
FRONTEND_URL=http://localhost:5173


